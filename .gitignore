# itch.io distribution & marketing assets (cover/thumbnail/screenshots, store
# description, devlog, postmortem, cover-wip art) — staged locally for upload,
# not part of the shippable game (index.html is the only artifact that ships).
itch/

# Playwright MCP artifacts (console logs, page snapshots)
.playwright-mcp/

# Remaster regenerables: procedural reference exports, i2i staging output, and
# the rebuilt BGM audition harness (curated remaster/assets/*.png stay tracked)
remaster/refs/
remaster/assets/gen/
remaster/bgm2-demo.html
remaster/index.html.bak

# Local pre-integration backup (rollback safety, not for the repo)
design/index.html.bak

# Generated audition harness (rebuild with: node design/build-bgm.js)
bgm-demo.html

# Cut-in placeholder art — swap in real generated assets; the cut-in degrades
# gracefully (loading/missing fallback) when it is absent.
character.png

# Portrait cut-in decks — visual-4choice provenance, kept locally, not tracked
design/portraits/

# Claude Code local config (memory, settings) — machine-local, not for the repo
.claude/

# Generated authoring demos (rebuild with design/build-*-demo.js)
theme-demo.html
sfx-demo.html
balance-demo.html
stage3-demo.html

# Player-ship candidate preview harness (throwaway; visual-4choice audition for
# roadmap task D, port the chosen drawShip into index.html drawPlayer on 反映)
ship-demo.html

# Endurance-bar presentation tuning harness (throwaway; port the chosen look into
# index.html drawSurvivalBar on 反映, then this can be deleted)
endurance-demo.html

# Bomb-item differentiation harness (throwaway; port the chosen token look into
# index.html drawItems on 反映, then this can be deleted)
bomb-item-demo.html

# Gravity-well-bends-items experiment harness (throwaway prototype; port the chosen
# behaviour into index.html's applyGravity/updateItems on 反映, then this can be deleted)
well-item-demo.html
